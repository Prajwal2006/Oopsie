# Pulled automatically by `neon deploy` / `neon env pull` into .env.local
DATABASE_URL=            # pooled (-pooler) Neon connection string, used by the app
DATABASE_URL_UNPOOLED=   # direct connection string, used by `npm run migrate`
NEON_BRANCH=

# Optional
CRON_SECRET=             # Vercel sends `Authorization: Bearer $CRON_SECRET` to /api/cron/cleanup
RATE_LIMIT_SALT=         # salt for hashed client IPs in the rate_limits table
NEXT_PUBLIC_SITE_URL=    # absolute origin for OG metadata (defaults to the Vercel production URL)
